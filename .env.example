# GEMINI_API_KEY: Used server-side for Gemini AI market reasoning and quality checks.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# MONGODB_URI: (Optional) Database connection string.
# When omitted, the app runs seamlessly with rich local demo in-memory storage.
MONGODB_URI=""

# JWT_SECRET: (Optional in dev) Secret key for JWT authentication tokens.
# When omitted, a safe development-only fallback key is used automatically.
JWT_SECRET=""

# WEATHER_API_KEY: (Optional) Live weather provider API key.
# When omitted, realistic agro-meteorological simulation is used automatically with zero setup.
WEATHER_API_KEY=""

# MAPS_API_KEY: (Optional) Google Maps API key for distance matrix.
# When omitted, local transport-distance & freight cost estimation engine is used with zero setup.
MAPS_API_KEY=""
